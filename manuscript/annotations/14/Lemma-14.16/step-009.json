          "snippet": {
            "text": "private lemma gain_step (H : History G) (o i : ℕ) :\n    gainChart H o i = gainChart H o (i+1) * puffs (H.S.block i) := by\n  unfold gainChart puffs\n  rw [H.S.scale_succ, Real.rpow_def_of_pos (by positivity), ← Real.exp_add]\n  congr 1\n  ring",
            "line": 174,
            "truncated": false
          },
          "destination": {
            "resolution": "exact",
            "href": "https://github.com/yang-mills-group/OpenAI-YM-20261028/blob/3456e5e75cf8d4cd558955a5c7638fba2d68f464/YM/Work/G09.lean",
            "fragment": "L174-L179"
          },
          "proof_context": {
            "declaration": "YM.Work.G09.gain_step",
            "lines": [
              174,
              179
            ],
            "conclusion": "`gainChart o i = gainChart o (i+1) * puffs (block i)`, so the product of the factors ℓ_i^(1/8) is the exponential of the scale difference over 8."
          }
        }
      }
