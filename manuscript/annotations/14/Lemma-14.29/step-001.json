          "snippet": {
            "text": "def Grill (C : Family G) (F : Order) := ∀ d m : ℕ, ∃ k : ℕ, m≤k ∧ ∀ n : ℕ, ∀ v : Fin n → C.book.Token,\n    (∀ i,(v i).fst ≤ d) → Grid.plain (C := C) v → ∀ x : Fin n→ Lattice.Cover, Order.grid C k x ∈ generic n →\n    ∃ P : Grid.Covering (C:=C) k v x, Grid.Covering.Works k v x P F",
