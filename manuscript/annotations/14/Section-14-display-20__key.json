            "text": "def Wcmain (C : Family G) := ∀ d (R ε : ℝ), 0 < R → 0 < ε → ∃ A : ℝ, 0 ≤ A ∧ ∀ m,\n    C.ref d ≤ m → ∀ᶠ N in atTop, ∀ p, ∀ v : C.book.Ref d, ‖v‖ ≤ R →\n    centeredBudget C ⟨d,v⟩ (A*C.S.a m^(-(d:ℝ)-ε)) m N p",
