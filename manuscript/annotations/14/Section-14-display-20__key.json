            "resolution": "exact",
            "href": "https://github.com/yang-mills-group/OpenAI-YM-20261028/blob/3456e5e75cf8d4cd558955a5c7638fba2d68f464/YM/Extraction/Center.lean",
            "fragment": "L21-L23"
          },
          "proof_context": {
            "declaration": "YM.Extraction.centeredBudget",
            "lines": [
              21,
              23
            ],
            "conclusion": "For m <= N and every anchor o, the observable `seen v o` is `Interior` on the chamber of the centered tiling and its `rootTest` is at most the budget A."
          }
        }
