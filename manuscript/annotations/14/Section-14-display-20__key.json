          "snippet": {
            "text": "def centeredBudget (v : C.book.Token) (A : ℝ) (m N p : ℕ) : Prop := ∃ h : m ≤ N,\n    C.ref v.1 ≤ N ∧ ∀ o : Site (C.side N p), Interior ((center C.S p h o).chamber 0) (C.seen v o) ∧\n    (center C.S p h o).rootTest (C.beta N p) (C.seen v o) ≤ A",
