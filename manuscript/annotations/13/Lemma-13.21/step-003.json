          "snippet": {
            "text": "lemma due_large (hc : c.direct ≤ 1) (U : Config G n) (p : Cell n)\n    (ht : b.threshold < G.chord (faceValue U p)) : b.threshold^2/4 ≤ due c b U p := by\n  let r := G.chord (faceValue U p)\n  have hb := b.threshold_pos\n  have hl : c.linear ≤ 1/4 := by have := c.kink; linarith\n  unfold due; rw [if_pos ht]\n  have he : c.linear*b.threshold*r ≤ (1/4)*r*r := by dsimp only [r]; gcongr; exact G.chord_nonneg _\n  nlinarith [G.chord_price (faceValue U p)]",
            "line": 42,
            "truncated": false
          },
          "destination": {
            "resolution": "exact",
            "href": "https://github.com/yang-mills-group/OpenAI-YM-20261028/blob/3456e5e75cf8d4cd558955a5c7638fba2d68f464/YM/Extra/WILSON_STARTUP/Ownership.lean",
            "fragment": "L42-L49"
