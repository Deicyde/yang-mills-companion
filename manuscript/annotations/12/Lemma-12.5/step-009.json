            "fragment": "L23-L25"
          },
          "proof_context": {
            "declaration": "YM.Stationary.seriesLeg",
            "lines": [
              23,
              25
            ],
            "conclusion": "`seriesLeg` is the geometric sum `Σ_{a<n} mode p (x with x i = a)` for `x i ≥ 0` and its negative `-Σ_{a<|n|} mode p (x with x i = -(a+1))` for `x i < 0`, and the empty sum for `x i = 0`."
          }
