          "snippet": {
            "text": "private lemma deriv_inj (H : Hol G) (B : Fin m → Slot) (hl : lifts H d m B)\n    (hd : DifferentiableAt ℝ (bring H d B) 0) :\n    Function.Injective (fderiv ℝ (bring H d B) 0) := by\n  intro x y hxy\n  let D := fderiv ℝ (bring H d B) 0\n  change D x = D y at hxy\n  have h : D (x-y) = 0 := by rw [map_sub, hxy, sub_self]\n  apply sub_eq_zero.mp\n  apply hl\n  intro i\n  change fderiv ℝ (fun a => bring H d B a i) 0 (x-y) = _\n  rw [fderiv_apply hd i]\n  change D (x-y) i = 0\n  rw [h]; rfl",
            "line": 106,
            "truncated": false
          },
          "destination": {
            "resolution": "exact",
            "href": "https://github.com/yang-mills-group/OpenAI-YM-20261028/blob/3456e5e75cf8d4cd558955a5c7638fba2d68f464/YM/Work/G04.lean",
