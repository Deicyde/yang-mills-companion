          "snippet": {
            "text": "theorem glow_sums {A : Snap G d} (h : ∀ b, glow A b = 0) (x : Cover) {i j : Axis} (hi : i < j) :\n    ∑ k ∈ Finset.range (d-1), net (expand d A k) i j (castPos x) 1 = 0 := by\n  let b : Slot := ⟨route 0 x 1,⟨(i,j),hi⟩⟩\n  have he : b.offset = x := route_end ..\n  have hh := h b\n  unfold glow at hh\n  rw [he] at hh\n  change Exterior.linkSum _ _ (square i j) = 0 at hh\n  rw [square_sum] at hh\n  simp only [edge_sum, castPos_step] at hh\n  simp_rw [net, partial_eq_diff, Finset.sum_sub_distrib]\n  rw [← hh]; abel",
            "line": 115,
            "truncated": false
          },
          "destination": {
            "resolution": "exact",
            "href": "https://github.com/yang-mills-group/OpenAI-YM-20261028/blob/3456e5e75cf8d4cd558955a5c7638fba2d68f464/YM/Work/G03.lean",
