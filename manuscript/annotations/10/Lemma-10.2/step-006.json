          },
          "proof_context": {
            "declaration": "YM.Work.G03.glow_sums",
            "lines": [
              115,
              126
            ],
            "conclusion": "If all plaquette measurements `glow` vanish, then for every cover point x the sum over orders of `net (expand d A k) i j (castPos x) 1` is zero."
          }
        }
